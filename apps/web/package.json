{
  "name": "@spar/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --port 5173",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "ios:sync": "pnpm build && cap sync ios",
    "ios:build": "pnpm ios:sync && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator -destination \"generic/platform=iOS Simulator\" -derivedDataPath ios/DerivedData CODE_SIGNING_ALLOWED=NO build",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@mediapipe/tasks-vision": "^0.10.21",
    "@spar/gestures": "workspace:*",
    "@spar/netcode": "workspace:*",
    "@spar/protocol": "workspace:*",
    "@spar/sim": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
